{
  "name": "jova-language-support",
  "displayName": "JOVA Language Support",
  "description": "Language support for JOVA (.jova): comments, diagnostics, completion, hover, symbols, folding, rename, selection ranges, and quick fixes.",
  "version": "0.1.0",
  "publisher": "mrcodeislife718",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:jova"],
  "scripts": {
    "prepare-server": "node ./scripts/prepare-server.js",
    "vscode:prepublish": "npm run prepare-server"
  },
  "contributes": {
    "languages": [
      {
        "id": "jova",
        "aliases": ["JOVA", "jova"],
        "extensions": [".jova"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jova",
        "scopeName": "source.jova",
        "path": "./syntaxes/jova.tmLanguage.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  }
}
